APP_NAME="Tây Đô Auto Car"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
DEPLOY_HOOK_KEY=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Chỉ dùng cho lần tạo quản trị viên đầu tiên; xóa password sau khi đăng nhập thành công.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME="Quản trị Tây Đô"

# Để trống nếu dùng trình soạn thảo HTML dự phòng.
CKEDITOR_LICENSE_KEY=

